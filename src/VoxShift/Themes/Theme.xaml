<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================================================
         VoxShift design system (v0.0.7). One place for colours, type, surfaces and controls; every window
         uses these resources so the main window, the soundboard dock, VR Controller Mode and the dialogs
         look like one product.

         Layers (dark to light): Inset (wells, tracks) < Window < Card < Surface (controls) < hover/pressed.
         Accents: blue = microphone, violet = application audio, teal = soundboard. Green/amber/red are
         reserved for status. Depth comes from layering, hairline borders and soft gradients; drop shadows
         are only used on small, static elements (never around live meters).
         ================================================================================================ -->

    <!-- Palette -->
    <Color x:Key="WindowBackgroundColor">#FF0F1115</Color>
    <Color x:Key="CardColor">#FF171A22</Color>
    <Color x:Key="CardBorderColor">#FF262B37</Color>
    <Color x:Key="MicAccentColor">#FF5B9BFF</Color>
    <Color x:Key="MicAccentColor2">#FF3B78F2</Color>
    <Color x:Key="AppAccentColor">#FFA988FF</Color>
    <Color x:Key="AppAccentColor2">#FF7C5BF2</Color>
    <Color x:Key="SoundAccentColor">#FF2BD4BD</Color>
    <Color x:Key="SoundAccentColor2">#FF12A693</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF191C25" Offset="0" />
        <GradientStop Color="#FF14171E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="InsetBrush" Color="#FF0B0D11" />
    <SolidColorBrush x:Key="InsetBorderBrush" Color="#FF1D212B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF222733" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF3F5FA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA2ABBB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF737C8D" />

    <SolidColorBrush x:Key="MicAccentBrush" Color="{StaticResource MicAccentColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SoundAccentBrush" Color="{StaticResource SoundAccentColor}" />
    <SolidColorBrush x:Key="MicTintBrush" Color="#245B9BFF" />
    <SolidColorBrush x:Key="AppTintBrush" Color="#24A988FF" />
    <SolidColorBrush x:Key="SoundTintBrush" Color="#242BD4BD" />

    <SolidColorBrush x:Key="OkBrush" Color="#FF3DDC84" />
    <SolidColorBrush x:Key="WaitBrush" Color="#FFF5C04E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="IdleBrush" Color="#FF5F6878" />
    <SolidColorBrush x:Key="OkTintBrush" Color="#243DDC84" />
    <SolidColorBrush x:Key="WaitTintBrush" Color="#24F5C04E" />
    <SolidColorBrush x:Key="ErrorTintBrush" Color="#24FF6B6B" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F232D" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF272C38" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#FF2F3543" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF3D4557" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="OnPillBrush" Color="#FF3DDC84" />
    <SolidColorBrush x:Key="OffPillBrush" Color="#FF303644" />
    <SolidColorBrush x:Key="MutedPillBrush" Color="#FFF5C04E" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#B3FFFFFF" />

    <LinearGradientBrush x:Key="MicActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource MicAccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource MicAccentColor2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AppActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AppAccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AppAccentColor2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SoundActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SoundAccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource SoundAccentColor2}" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Small upper-case label above a group of controls. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,14,16,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Recessed well: holds segmented controls, meters and read-outs. -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InsetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <!-- Inline message strip. Background/BorderBrush are set per severity where it is used. -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <!-- Status badge (pill) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Round tinted icon holder used in headers and channel strips. -->
    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Source selector button (radio). Tag = accent gradient brush. Sits inside an Inset well. -->
    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Base" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
                        <Border x:Name="Active" CornerRadius="12" Opacity="0" Background="{TemplateBinding Tag}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0"
                                                  Color="{Binding Tag.GradientStops[0].Color, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border.Effect>
                        </Border>
                        <!-- Soft top highlight gives the selected button a slightly raised look. -->
                        <Border x:Name="Sheen" CornerRadius="12" Opacity="0" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#26FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="12,10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Base" Property="Background" Value="#0FFFFFFF" />
                            <Setter TargetName="Base" Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.4" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link-like text button -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MicAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="2,3">
                        <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="12.5" FontWeight="SemiBold" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider with a large thumb; click anywhere on the track to jump (easy with a VR laser pointer).
         Foreground = fill colour. -->
    <Style x:Key="SliderFillRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3,0,0,3" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmptyRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="0,3,3,0" Background="#FF2A303D" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BigSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Halo" Fill="#2EFFFFFF" Margin="-5" Opacity="0" />
                        <Ellipse Fill="#FFF3F5FA" Stroke="{StaticResource WindowBackgroundBrush}" StrokeThickness="3" />
                        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BigSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource MicAccentBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="200" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border x:Name="Focus" CornerRadius="8" Margin="-4,2" BorderThickness="1.5" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillRepeat}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyRepeat}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BigSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard push button. -->
    <Style x:Key="BigButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" CornerRadius="12" Background="#12FFFFFF" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="#33000000" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
        <Setter Property="Background" Value="#2EE5484D" />
        <Setter Property="BorderBrush" Value="#80E5484D" />
        <Setter Property="Foreground" Value="#FFFFC9CB" />
    </Style>
    <Style x:Key="AccentBigButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
        <Setter Property="Background" Value="{StaticResource MicActiveBrush}" />
        <Setter Property="BorderBrush" Value="#FF7DB0FF" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Quiet button: no surface until hovered (dialog "Cancel", secondary actions). -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>
    <!-- Square icon button with a VR-friendly 44 px hit target. -->
    <Style x:Key="SquareIconButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Toolbar toggle (header buttons, "Edit"). Tag = accent brush for the checked state. -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Tag" Value="{StaticResource SoundAccentBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="OnTint" CornerRadius="12" Background="{TemplateBinding Tag}" Opacity="0" />
                        <Border x:Name="OnRing" CornerRadius="12" BorderBrush="{TemplateBinding Tag}" BorderThickness="1.5" Opacity="0" />
                        <Border x:Name="Hover" CornerRadius="12" Background="#12FFFFFF" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OnTint" Property="Opacity" Value="0.16" />
                            <Setter TargetName="OnRing" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ON/OFF option: title + description as content and an unmistakable switch on the right.
         Tag = accent brush used for the ON state. -->
    <Style x:Key="OptionToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Tag" Value="{StaticResource OnPillBrush}" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="OnTint" CornerRadius="14" Background="{TemplateBinding Tag}" Opacity="0" />
                        <Border x:Name="OnRing" CornerRadius="14" BorderBrush="{TemplateBinding Tag}" BorderThickness="1.5" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <Grid Margin="16,10,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <!-- Switch -->
                            <Border x:Name="Pill" Grid.Column="1" Width="66" Height="34" CornerRadius="17" Margin="14,0,0,0"
                                    Background="{StaticResource OffPillBrush}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Knob" Width="26" Height="26" Fill="#FFAAB3C2" HorizontalAlignment="Left" Margin="4,0" />
                                    <TextBlock x:Name="PillText" Text="OFF" FontSize="11" FontWeight="Bold" Foreground="#FFAAB3C2"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="PillText" Property="Text" Value="ON" />
                            <Setter TargetName="PillText" Property="Foreground" Value="#FF0F1115" />
                            <Setter TargetName="PillText" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PillText" Property="Margin" Value="11,0,0,0" />
                            <Setter TargetName="OnTint" Property="Opacity" Value="0.10" />
                            <Setter TargetName="OnRing" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status tile: small label above a strong value. -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InsetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,9,10,10" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinHeight" Value="58" />
    </Style>
    <Style x:Key="ChipLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ChipValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Large selectable chip for soundboard collections (ListBoxItem). -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" MinHeight="56" MinWidth="120" Padding="22,0" CornerRadius="28"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="Focus" CornerRadius="28" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoundActiveBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6FE6D6" />
                            <Setter Property="Foreground" Value="#FF06211D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Soundboard pad (dock and VR Controller Mode). DataContext = SoundButtonViewModel.
         Idle: quiet surface with a tinted play badge. Playing: teal wash, bright ring, filled badge and a
         progress bar along the bottom edge. -->
    <Style x:Key="BigSoundTile" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" />
                        <Border x:Name="Active" CornerRadius="14" Background="{StaticResource SoundActiveBrush}" Opacity="0" />
                        <Border x:Name="ActiveRing" CornerRadius="14" BorderBrush="{StaticResource SoundAccentBrush}" BorderThickness="2" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <Grid Margin="12,8,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="0,0,11,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Badge" Fill="{StaticResource SoundTintBrush}" />
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SoundAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{TemplateBinding FontSize}" LineHeight="19" />
                        </Grid>
                        <Grid x:Name="ProgressHost" VerticalAlignment="Bottom" Height="4" Margin="14,0,14,7" Visibility="Collapsed">
                            <Border Background="#33FFFFFF" CornerRadius="2" />
                            <Border Background="{StaticResource SoundAccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE895;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE71A;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FF06211D" />
                            <Setter TargetName="Badge" Property="Fill" Value="{StaticResource SoundAccentBrush}" />
                            <Setter TargetName="ProgressHost" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WaitBrush}" />
                            <Setter TargetName="Badge" Property="Fill" Value="{StaticResource WaitTintBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80F5C04E" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.7" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible card for secondary settings: a full-width header you can click anywhere. -->
    <Style x:Key="ExpanderHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" MinHeight="64">
                        <Border x:Name="Hover" CornerRadius="15" Background="#0AFFFFFF" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed" />
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Style="{StaticResource ExpanderHeaderToggle}" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="16,2,16,16" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared header layout for cards and expanders: icon chip, title, one-line description. -->
    <Style x:Key="HeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="HeaderCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style x:Key="OptionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OptionDescription" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- Small state badge next to a title (ON AIR, MUTED, PLAYING). -->
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource OkTintBrush}" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="7,2,7,3" />
    </Style>
    <!-- Numeric read-out (volume percentages). -->
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="52" />
    </Style>
</ResourceDictionary>
