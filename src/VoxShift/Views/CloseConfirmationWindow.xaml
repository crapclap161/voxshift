<Window x:Class="VoxShift.Views.CloseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxShift" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" AutomationProperties.Name="Close VoxShift"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="24,22,24,22">
        <TextBlock x:Name="Heading" Text="What would you like to do with VoxShift?" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,18"
                   Text="Minimizing keeps your microphone, application audio and soundboard running from the system tray." />
        <Button x:Name="MinimizeButton" Content="Minimize to Tray" IsDefault="True" Click="OnMinimize"
                Style="{StaticResource AccentBigButton}" AutomationProperties.AutomationId="CloseMinimizeToTray" />
        <Button x:Name="QuitButton" Content="Quit VoxShift" Click="OnQuit" Margin="0,10,0,0"
                Style="{StaticResource DangerButton}" AutomationProperties.AutomationId="CloseQuit" />
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,10,0,0"
                Style="{StaticResource BigButton}" AutomationProperties.AutomationId="CloseCancel" />
        <CheckBox x:Name="RememberBox" Content="Remember my choice" Margin="0,18,0,0" MinHeight="36"
                  AutomationProperties.AutomationId="CloseRemember"
                  ToolTip="You can change this later under Settings: When clicking the X button" />
    </StackPanel>
</Window>
