<Window x:Class="VoxShift.Views.CloseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxShift" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" AutomationProperties.Name="Close VoxShift"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel x:Name="Root" Margin="24,22,24,22">
        <DockPanel Margin="0,0,0,18">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="14" Background="{StaticResource MicTintBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="19" HorizontalAlignment="Center" Foreground="{StaticResource MicAccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="What would you like to do with VoxShift?" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Minimizing keeps your microphone, application audio and soundboard running from the system tray." />
            </StackPanel>
        </DockPanel>
        <Button x:Name="MinimizeButton" IsDefault="True" Click="OnMinimize" MinHeight="56"
                Style="{StaticResource AccentBigButton}" AutomationProperties.AutomationId="CloseMinimizeToTray" AutomationProperties.Name="Minimize to Tray">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73F;" FontSize="14" Margin="0,0,10,0" />
                <TextBlock Text="Minimize to Tray" FontSize="14.5" />
            </StackPanel>
        </Button>
        <Button x:Name="QuitButton" Click="OnQuit" Margin="0,10,0,0" MinHeight="56"
                Style="{StaticResource DangerButton}" AutomationProperties.AutomationId="CloseQuit" AutomationProperties.Name="Quit VoxShift">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="14" Margin="0,0,10,0" />
                <TextBlock Text="Quit VoxShift" FontSize="14.5" />
            </StackPanel>
        </Button>
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Margin="0,10,0,0" MinHeight="52"
                Style="{StaticResource GhostButton}" AutomationProperties.AutomationId="CloseCancel" />
        <CheckBox x:Name="RememberBox" Content="Remember my choice" Margin="0,16,0,0" MinHeight="36"
                  AutomationProperties.AutomationId="CloseRemember"
                  ToolTip="You can change this later under Preferences: When clicking the X button" />
    </StackPanel>
</Window>
