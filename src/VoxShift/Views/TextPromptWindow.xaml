<Window x:Class="VoxShift.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <TextBox x:Name="Input" MaxLength="60" AutomationProperties.LabeledBy="{Binding ElementName=LabelText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Padding="20,5" Margin="0,0,8,0" Click="OnOk" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Padding="16,5" />
        </StackPanel>
    </StackPanel>
</Window>
