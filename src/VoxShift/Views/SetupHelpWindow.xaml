<Window x:Class="VoxShift.Views.SetupHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup help" Width="540" Height="700" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <!-- Numbered step badge -->
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource MicTintBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MicAccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Padding="20,16,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Set up VoxShift for VRChat" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16"
                           Text="Four steps, about two minutes. You only do this once." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock Style="{StaticResource H}" Text="Install the virtual audio cable" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="VRChat can only record from an input device, so a virtual cable is required. Download the free VB-CABLE driver from vb-audio.com/Cable, extract the ZIP, right-click VBCABLE_Setup_x64.exe → Run as administrator → Install Driver, then reboot. (Driver installation is the only step that needs administrator rights; this app itself does not.)" />
                        <TextBlock Style="{StaticResource P}" Text="After installing you get two devices: “CABLE Input” (playback – this app sends audio into it) and “CABLE Output” (recording – VRChat listens to it)." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock Style="{StaticResource H}" Text="Keep Windows defaults on your real devices" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="Windows sometimes makes CABLE Input the default playback device after installation. Open Sound settings and set your headphones/speakers as the default output, and your real microphone as the default input. Otherwise you will not hear anything and every sound would be sent to VRChat." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock Style="{StaticResource H}" Text="Configure this app" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="Open Sources &amp; devices: choose your microphone, choose the application (e.g. Spotify or your browser – start it first, then press refresh), and set the volumes in the mixer. The VRChat output can stay on Auto-detect." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepNumber}" /></Border>
                            <TextBlock Style="{StaticResource H}" Text="Configure VRChat (once)" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="In VRChat open the Launch Pad → Settings → Audio &amp; Voice → Microphone and select “CABLE Output (VB-Audio Virtual Cable)”. You never need to change it again: switching between Microphone and Application happens inside this app." />
                        <TextBlock Style="{StaticResource P}" Text="Tip: VRChat's noise suppression can make music sound thin. Turn off “Noise Suppression” in VRChat's audio settings while playing music, and keep your mic in Toggle/Open mode rather than push-to-talk when broadcasting music." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource InsetBorderBrush}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Step}" Background="{StaticResource WaitTintBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource WaitBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource H}" Text="Limitations" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource P}" Text="• Capture works per application (process tree), not per window or browser tab. All tabs of the selected browser are sent." />
                        <TextBlock Style="{StaticResource P}" Text="• DRM-protected playback (e.g. some streaming services in Edge/Chrome) is delivered as silence by Windows. Use the service's desktop app or disable hardware-protected playback." />
                        <TextBlock Style="{StaticResource P}" Text="• Application capture requires Windows 11 or Windows 10 build 20348 or newer." />
                        <TextBlock Style="{StaticResource P}" Text="• Do not select VRChat itself as the application – people would hear their own voices." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Get VB-CABLE" Margin="0,0,8,0" MinHeight="44" Style="{StaticResource BigButton}" Click="OnGetCable" />
                <Button Content="Sound settings" Margin="0,0,8,0" MinHeight="44" Style="{StaticResource BigButton}" Click="OnSoundSettings" />
                <Button Content="Close" MinWidth="96" MinHeight="44" Style="{StaticResource AccentBigButton}" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
