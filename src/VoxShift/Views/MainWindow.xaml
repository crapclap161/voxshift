<Window x:Class="VoxShift.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:VoxShift.Controls"
        xmlns:vm="clr-namespace:VoxShift.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="VoxShift"
        Width="470" Height="840" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Topmost="{Binding AlwaysOnTop}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding SelectMicrophoneModeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding SelectApplicationModeCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshApplicationsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <c:StateToBrushConverter x:Key="StateBrush" />
        <c:BoolToVisibilityConverter x:Key="BoolVis" />
        <c:NotEmptyToVisibilityConverter x:Key="NotEmptyVis" />

        <DataTemplate x:Key="AppItemTemplate" DataType="{x:Type vm:AppItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding PlayingGlyph}" FontSize="11"
                           Foreground="{StaticResource OkBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeviceItemTemplate" DataType="{x:Type vm:DeviceItem}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding Detail, Converter={StaticResource NotEmptyVis}}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SoundTileTemplate" DataType="{x:Type vm:SoundButtonViewModel}">
            <Button Style="{StaticResource SoundTile}" Command="{Binding PlayCommand}" ToolTip="{Binding ToolTip}"
                    Width="128" Height="56" Margin="0,0,8,8" AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="Play or stop this sound">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play (overlap)" Command="{Binding PlayAgainCommand}" />
                        <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                        <Separator />
                        <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
                        <MenuItem Header="Relink file…" Command="{Binding RelinkCommand}" />
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                        <Separator />
                        <MenuItem Header="Remove from soundboard" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <Style x:Key="OnAirBadge" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="#332ECC71" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Brand bar ===== -->
        <DockPanel Grid.Row="0" Margin="18,14,18,0" LastChildFill="False">
            <Image Source="pack://application:,,,/Assets/app.ico" Width="22" Height="22" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="VoxShift logo" />
            <TextBlock Text="VoxShift" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Style="{StaticResource Pill}" Background="#FF262A33" Margin="10,0,0,0">
                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Text="Ctrl+1 mic · Ctrl+2 app" ToolTip="Keyboard shortcuts while this window is focused. Use the global hotkey (Options) while in VRChat." />
        </DockPanel>

        <!-- ===== Header: transmission state ===== -->
        <Border Grid.Row="1" Margin="16,12,16,10" Padding="14,10" CornerRadius="12" BorderThickness="1"
                BorderBrush="{StaticResource CardBorderBrush}" Background="{StaticResource CardBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="OnAirDot" Width="12" Height="12" Margin="2,0,12,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF2ECC71" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding TransmitTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding TransmitTitle}" />
                    <TextBlock Text="{Binding TransmitDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <Grid Margin="0,8,0,0" ToolTip="Level sent to VRChat (after volume and limiter)">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="To VRChat" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <c:LevelMeter Grid.Column="1" Level="{Binding OutputLevel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="LIMIT" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"
                                   Foreground="{StaticResource WaitBrush}" VerticalAlignment="Center"
                                   ToolTip="The limiter is preventing clipping – consider lowering the volume."
                                   Visibility="{Binding IsLimiting, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,12">
            <StackPanel>
                <!-- ===== Mode buttons ===== -->
                <Grid Margin="0,0,0,10" Height="96">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="MicModeButton" Style="{StaticResource ModeButton}" GroupName="Mode"
                                 Tag="{StaticResource MicActiveBrush}" IsChecked="{Binding IsMicrophoneMode, Mode=TwoWay}"
                                 AutomationProperties.Name="Microphone mode"
                                 ToolTip="Send your microphone to VRChat – application audio is not sent (Ctrl+1)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="MICROPHONE" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AppModeButton" Grid.Column="2" Style="{StaticResource ModeButton}" GroupName="Mode"
                                 Tag="{StaticResource AppActiveBrush}" IsChecked="{Binding IsApplicationMode, Mode=TwoWay}"
                                 AutomationProperties.Name="Application audio mode"
                                 ToolTip="Send the selected application's audio to VRChat – your microphone is not sent (Ctrl+2)">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="APPLICATION AUDIO" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- ===== Microphone card ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Status.MicrophoneState, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="Microphone" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource OnAirBadge}" Visibility="{Binding IsMicrophoneOnAir, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="ON AIR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <TextBlock Text="{Binding MicrophoneVolume, StringFormat={}{0} %}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{StaticResource MicAccentBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ComboBox Margin="0,10,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Microphones}"
                                  SelectedItem="{Binding SelectedMicrophone}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                  AutomationProperties.Name="Microphone device" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="False"
                                    SmallChange="1" LargeChange="10" Value="{Binding MicrophoneVolume, Mode=TwoWay}"
                                    AutomationProperties.Name="Microphone volume" ToolTip="Microphone level sent to VRChat (0–200 %)" />
                        </Grid>
                        <c:LevelMeter Margin="0,8,0,0" Level="{Binding MicrophoneLevel}" IsLive="{Binding IsMicrophoneMode}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding Status.MicrophoneMessage}" />
                    </StackPanel>
                </Border>

                <!-- ===== Application card ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Status.ApplicationState, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="Application audio" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource OnAirBadge}" Visibility="{Binding IsApplicationOnAir, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="ON AIR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <TextBlock Text="{Binding ApplicationVolume, StringFormat={}{0} %}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                                      ItemTemplate="{StaticResource AppItemTemplate}" MaxDropDownHeight="420"
                                      AutomationProperties.Name="Application to capture" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButton}" Command="{Binding RefreshApplicationsCommand}"
                                    ToolTip="Refresh the list of running applications (F5)" AutomationProperties.Name="Refresh applications">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" SmallChange="1" LargeChange="10"
                                    Value="{Binding ApplicationVolume, Mode=TwoWay}"
                                    AutomationProperties.Name="Application volume" ToolTip="Application level sent to VRChat (0–200 %). Does not change what you hear." />
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsLoadingApplications, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Scanning running applications…" Style="{StaticResource Caption}" />
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" AutomationProperties.Name="Scanning applications" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WaitBrush}"
                                   Visibility="{Binding HasNoApplications, Converter={StaticResource BoolVis}}"
                                   Text="No running applications found. Start your music app or browser, then press refresh (F5)." />
                        <c:LevelMeter Margin="0,8,0,0" Level="{Binding ApplicationLevel}" IsLive="{Binding IsApplicationMode}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding Status.ApplicationMessage}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Browsers are captured as a whole: all tabs/windows of the selected browser are sent. Use a separate browser for music if you need isolation." />
                    </StackPanel>
                </Border>

                <!-- ===== Soundboard (collapsible soundbar, drop target) ===== -->
                <Border x:Name="SoundboardCard" Style="{StaticResource Card}" DataContext="{Binding Soundboard}" AllowDrop="True"
                        DragEnter="OnSoundboardDragEnter" DragOver="OnSoundboardDragOver" DragLeave="OnSoundboardDragLeave" Drop="OnSoundboardDrop"
                        AutomationProperties.Name="Soundboard">
                    <Grid>
                        <StackPanel>
                            <!-- Header: always visible, also when collapsed -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="8,4" Margin="8,0,0,0"
                                        Command="{Binding StopAllCommand}" ToolTip="Stop all sounds"
                                        AutomationProperties.Name="Stop all sounds"
                                        Visibility="{Binding AnyPlaying, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop all" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ToggleExpandedCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="Show or hide the soundboard"
                                        ToolTip="Show or hide the soundboard">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <DockPanel>
                                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter Property="Text" Value="&#xE76C;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{StaticResource SoundAccentBrush}" />
                                        <TextBlock DockPanel.Dock="Left" Text="SOUNDBOARD" Style="{StaticResource CardTitle}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Volume, StringFormat={}{0} %}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SoundAccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="10,1,0,0" />
                                    </DockPanel>
                                </Button>
                            </DockPanel>

                            <!-- Body: collapses with a short height/opacity animation -->
                            <StackPanel x:Name="SoundboardBody" Margin="0,10,0,0">
                                <StackPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </StackPanel.LayoutTransform>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                            </ObjectAnimationUsingKeyFrames>
                                                            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Collection selector -->
                                <Grid Visibility="{Binding HasBoards, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="Soundboard collection" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButton}" Command="{Binding NewBoardCommand}"
                                            ToolTip="New soundboard" AutomationProperties.Name="New soundboard">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource IconButton}" Command="{Binding RenameBoardCommand}"
                                            ToolTip="Rename soundboard" AutomationProperties.Name="Rename soundboard">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource IconButton}" Command="{Binding DeleteBoardCommand}"
                                            ToolTip="Delete soundboard (your audio files are kept)" AutomationProperties.Name="Delete soundboard">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <!-- Empty state / drop zone -->
                                <Grid Margin="0,10,0,0" MinHeight="118" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                                    <Rectangle RadiusX="10" RadiusY="10" Stroke="#FF3B4252" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#0DFFFFFF" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SoundAccentBrush}" />
                                        <TextBlock Text="Drop audio files here" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2" />
                                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                                                   Text="{Binding Source={x:Static vm:SoundboardViewModel.SupportedFormatsText}, StringFormat='or use Add sounds · {0}'}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Sound tiles -->
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Sounds}" ItemTemplate="{StaticResource SoundTileTemplate}"
                                              Focusable="False" AutomationProperties.Name="Sounds"
                                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Footer: add, volume, stop all -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding AddFilesCommand}" Padding="10,5"
                                            ToolTip="Add audio files (they stay where they are)" AutomationProperties.Name="Add sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"
                                                       Foreground="{StaticResource SoundAccentBrush}" />
                                            <TextBlock Text="Add sounds" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="14,0,8,0" />
                                    <Slider Grid.Column="2" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                            Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Soundboard volume"
                                            ToolTip="Soundboard volume sent to VRChat (0–200 %), independent of microphone and application volume" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding StopAllCommand}" Margin="10,0,0,0" Padding="10,5"
                                            ToolTip="Stop all sounds" AutomationProperties.Name="Stop all sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Stop all" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Inline feedback -->
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DismissMessageCommand}" ToolTip="Dismiss">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" />
                                    </Button>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Drag & drop target highlight (also over the collapsed soundbar) -->
                        <Grid Visibility="{Binding IsDragOver, Converter={StaticResource BoolVis}}" IsHitTestVisible="False" Margin="-6">
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource SoundAccentBrush}" StrokeThickness="2" StrokeDashArray="5 3">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="#FF14161B" Opacity="0.95" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="24" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SoundAccentBrush}" />
                                <TextBlock Text="{Binding DropHint}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,2" />
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="Files stay where they are. VoxShift only links to them." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== Virtual microphone card ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Status.OutputState, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="Virtual microphone (VRChat input)" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding Status.OutputMessage}" />
                        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="#264F8CFF" BorderBrush="#664F8CFF" BorderThickness="1"
                                Visibility="{Binding ShowCableSetup, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open setup guide" Margin="10,0,0,0" Padding="12,5" VerticalAlignment="Center"
                                        Command="{Binding OpenSetupGuideCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                           Text="VoxShift needs the free VB-CABLE driver to create the microphone VRChat listens to. It takes about two minutes to set up." />
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding VrchatHint}" />
                        <TextBlock Text="Output device (virtual cable playback side)" Style="{StaticResource FieldLabel}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}"
                                  ItemTemplate="{StaticResource DeviceItemTemplate}" AutomationProperties.Name="Virtual cable output device" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Setup help" Style="{StaticResource LinkButton}" Command="{Binding OpenSetupGuideCommand}" Margin="0,0,16,4" />
                            <Button Content="Get VB-CABLE" Style="{StaticResource LinkButton}" Command="{Binding OpenVbCableSiteCommand}" Margin="0,0,16,4" />
                            <Button Content="Sound settings" Style="{StaticResource LinkButton}" Command="{Binding OpenSoundSettingsCommand}" Margin="0,0,16,4" />
                            <Button Content="Retry now" Style="{StaticResource LinkButton}" Command="{Binding RetryCommand}" Margin="0,0,16,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Warning / notice banner ===== -->
                <Border Style="{StaticResource Card}" Background="#33F5B942" BorderBrush="#66F5B942"
                        Visibility="{Binding Status.Warning, Converter={StaticResource NotEmptyVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WaitBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Status.Warning}" TextWrapping="Wrap" FontSize="12" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="#33FF5C5C" BorderBrush="#66FF5C5C"
                        Visibility="{Binding Notice, Converter={StaticResource NotEmptyVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,3" Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ErrorBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <!-- ===== Options ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource CardTitle}" />
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,18,0" />
                            <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" Margin="0,0,18,0" />
                            <CheckBox Content="Start in tray" IsChecked="{Binding StartMinimized}" IsEnabled="{Binding MinimizeToTray}"
                                      ToolTip="Start hidden in the system tray (requires Minimize to tray)" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Toggle hotkey" IsChecked="{Binding HotkeyEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Text="{Binding HotkeyText, Mode=OneWay}" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" PreviewKeyDown="OnHotkeyBoxKeyDown"
                                     ToolTip="Click here and press the key combination (e.g. Ctrl+Alt+M)"
                                     AutomationProperties.Name="Toggle hotkey" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding HotkeyError}" Visibility="{Binding HotkeyError, Converter={StaticResource NotEmptyVis}}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Open log folder" Style="{StaticResource LinkButton}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,16,0" />
                            <Button Content="Recording devices" Style="{StaticResource LinkButton}" Command="{Binding OpenRecordingDevicesCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
