<Window x:Class="VoxShift.Views.SoundboardDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:VoxShift.Controls"
        xmlns:vm="clr-namespace:VoxShift.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="VoxShift Soundboard"
        Width="420" Height="900"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis" />
        <c:NotEmptyToVisibilityConverter x:Key="NotEmptyVis" />

        <DataTemplate x:Key="DockSoundTileTemplate" DataType="{x:Type vm:SoundButtonViewModel}">
            <Button Style="{StaticResource BigSoundTile}" Click="OnSoundTileClick" ToolTip="{Binding ToolTip}"
                    Height="72" Margin="0,0,10,10" AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="Play or stop this sound">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play (overlap)" Command="{Binding PlayAgainCommand}" />
                        <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                        <Separator />
                        <MenuItem Header="Rename…" Command="{Binding RenameCommand}" />
                        <MenuItem Header="Relink file…" Command="{Binding RelinkCommand}" />
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                        <Separator />
                        <MenuItem Header="Remove from soundboard" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <Style x:Key="DockCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0">
        <Grid x:Name="Root">
            <!-- ================= Expanded soundboard ================= -->
            <Grid x:Name="ExpandedPanel" Visibility="{Binding Soundboard.IsExpanded, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header (drag it to move VoxShift together with the dock) -->
                <Grid Grid.Row="0" DataContext="{Binding Soundboard}" Margin="14,10,12,6" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll"
                      ToolTip="Drag to move VoxShift and the soundboard together">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="20" Margin="2,0,10,0" Foreground="{StaticResource SoundAccentBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SOUNDBOARD" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SquareIconButton}" MinWidth="52" MinHeight="48" Cursor="Hand"
                            Command="{Binding CollapseCommand}" AutomationProperties.Name="Collapse the soundboard"
                            ToolTip="Collapse the soundboard into a slim strip">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Collection selector + management -->
                <Grid Grid.Row="1" DataContext="{Binding Soundboard}" Margin="14,4,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource DockCombo}" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Soundboard collection"
                              IsEnabled="{Binding HasBoards}" ToolTip="Switch soundboard collection" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SquareIconButton}" MinWidth="48" MinHeight="48" Command="{Binding NewBoardCommand}"
                            ToolTip="New soundboard collection" AutomationProperties.Name="New soundboard">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15" />
                    </Button>
                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource SquareIconButton}" MinWidth="48" MinHeight="48" Command="{Binding RenameBoardCommand}"
                            ToolTip="Rename soundboard collection" AutomationProperties.Name="Rename soundboard">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="15" />
                    </Button>
                    <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource SquareIconButton}" MinWidth="48" MinHeight="48" Command="{Binding DeleteBoardCommand}"
                            ToolTip="Delete soundboard collection (your audio files are kept)" AutomationProperties.Name="Delete soundboard">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15" />
                    </Button>
                </Grid>

                <!-- Main actions -->
                <Grid Grid.Row="2" DataContext="{Binding Soundboard}" Margin="14,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BigButton}" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Add sounds"
                            ToolTip="Add audio files. They stay where they are; VoxShift only links to them.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource SoundAccentBrush}" />
                            <TextBlock Text="Add sounds" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Grid.Column="2" MinWidth="76" MinHeight="52" Cursor="Hand" IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Edit sounds" FontSize="14" FontWeight="SemiBold"
                                  ToolTip="Edit mode: click a sound to rename, relink or remove it (no right-click needed)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Edit" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Grid.Column="4" Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}" AutomationProperties.Name="Stop all sounds"
                            ToolTip="Stop every sound that is playing">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="STOP ALL" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Sounds -->
                <Grid Grid.Row="3" DataContext="{Binding Soundboard}" Margin="14,0,4,0">
                    <!-- Empty state / drop zone -->
                    <Grid Margin="0,0,10,10" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#FF3B4252" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#0DFFFFFF" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SoundAccentBrush}" />
                            <TextBlock Text="Drop audio files here" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="{Binding Source={x:Static vm:SoundboardViewModel.SupportedFormatsText}, StringFormat='or use Add sounds · {0}'}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="SoundsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{Binding Sounds}" ItemTemplate="{StaticResource DockSoundTileTemplate}" Focusable="False"
                                      AutomationProperties.Name="Sounds" Margin="0,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer: volumes, monitoring, auto-mute, feedback -->
                <Border Grid.Row="4" Margin="14,4,14,14" Style="{StaticResource Card}" Padding="14,10,14,12">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Soundboard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VRChat volume" FontSize="12.5" Width="104" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource BigSlider}" Foreground="{StaticResource SoundAccentBrush}"
                                    Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Soundboard volume"
                                    ToolTip="Soundboard volume sent to VRChat (0–200 %), independent of microphone and application volume" />
                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0} %}" FontWeight="SemiBold" MinWidth="46" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource SoundAccentBrush}" Margin="8,0,0,0" />
                        </Grid>
                        <ToggleButton Margin="0,8,0,0" Style="{StaticResource OptionToggle}" MinHeight="60" Tag="{StaticResource SoundAccentBrush}"
                                      IsChecked="{Binding MonitorEnabled, Mode=TwoWay}" AutomationProperties.Name="Hear sounds myself"
                                      ToolTip="Also play soundboard sounds on your Windows default playback device (your headphones)">
                            <StackPanel>
                                <TextBlock Text="Hear sounds myself" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="Plays sounds in your headphones too" />
                            </StackPanel>
                        </ToggleButton>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="My volume" FontSize="12.5" Width="104" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource BigSlider}" Foreground="{StaticResource SoundAccentBrush}"
                                    Value="{Binding MonitorVolume, Mode=TwoWay}" IsEnabled="{Binding MonitorEnabled}"
                                    AutomationProperties.Name="Monitor volume"
                                    ToolTip="How loud you hear the sounds yourself (does not change what VRChat hears)" />
                            <TextBlock Grid.Column="2" Text="{Binding MonitorVolume, StringFormat={}{0} %}" FontWeight="SemiBold" MinWidth="46" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MonitorStatus}"
                                   Visibility="{Binding MonitorStatus, Converter={StaticResource NotEmptyVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonitorStatusIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </StackPanel>
                        <ToggleButton Margin="0,8,0,0" Style="{StaticResource OptionToggle}" MinHeight="60" Tag="{StaticResource SoundAccentBrush}"
                                      IsChecked="{Binding AutoMuteMicrophone, Mode=TwoWay}" AutomationProperties.Name="Auto-mute microphone during Soundboard playback"
                                      ToolTip="Mute your microphone (inside VoxShift only) while a sound plays; it comes back when the last sound ends">
                            <StackPanel>
                                <TextBlock Text="Auto-mute mic on sounds" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="{Binding MicrophoneStateText, StringFormat='Microphone: {0}'}" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Inline feedback -->
                        <DockPanel Margin="0,8,0,0" DataContext="{Binding Soundboard}" Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SquareIconButton}" MinWidth="40" MinHeight="40" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                            </Button>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WaitBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Width grip on the outer edge -->
                <Thumb Grid.RowSpan="5" HorizontalAlignment="Right"  Width="6" Cursor="SizeWE" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted"
                       ToolTip="Drag to change the soundboard width">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <!-- ================= Collapsed dock strip ================= -->
            <Grid x:Name="CollapsedPanel" DataContext="{Binding Soundboard}"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Margin="6,10,6,0" Style="{StaticResource BigButton}" MinHeight="64" Padding="0"
                        Command="{Binding ExpandCommand}" AutomationProperties.Name="Expand the soundboard"
                        ToolTip="Open the soundboard (you can also drop audio files here)">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="20" />
                </Button>
                <Button Grid.Row="1" Margin="6,8,6,8" Command="{Binding ExpandCommand}" Cursor="Hand" AutomationProperties.Name="Soundboard (click to expand)"
                        ToolTip="Soundboard: click to expand, or drop audio files here">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="12" Background="#FF1A1D23" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SoundAccentBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="#FF20242C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="20" HorizontalAlignment="Center" Foreground="{StaticResource SoundAccentBrush}" />
                        <TextBlock Text="SOUNDBOARD" FontSize="14" FontWeight="Bold" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <Border Margin="0,14,0,0" Style="{StaticResource Pill}" Background="#3322C1A8" HorizontalAlignment="Center"
                                Visibility="{Binding AnyPlaying, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding PlayingCount}" FontWeight="Bold" Foreground="{StaticResource SoundAccentBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Margin="6,0,6,10" Style="{StaticResource DangerButton}" MinHeight="64" Padding="0"
                        Command="{Binding StopAllCommand}" AutomationProperties.Name="Stop all sounds" ToolTip="Stop all sounds"
                        Visibility="{Binding AnyPlaying, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="18" />
                </Button>
            </Grid>

            <!-- Drag & drop highlight (expanded and collapsed) -->
            <Grid DataContext="{Binding Soundboard}" Visibility="{Binding IsDragOver, Converter={StaticResource BoolVis}}" IsHitTestVisible="False" Margin="6">
                <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource SoundAccentBrush}" StrokeThickness="2.5" StrokeDashArray="5 3">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#FF14161B" Opacity="0.95" />
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource SoundAccentBrush}" />
                    <TextBlock Text="{Binding DropHint}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,4" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Files stay where they are. VoxShift only links to them." />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
