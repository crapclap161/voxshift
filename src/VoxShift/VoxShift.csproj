<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.NotifyIcon (system tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VoxShift</AssemblyName>
    <RootNamespace>VoxShift</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>VoxShift</Title>
    <Description>VoxShift – VR-friendly audio switcher, mixer and soundboard for VRChat.</Description>
    <AssemblyTitle>VoxShift</AssemblyTitle>
    <!-- WPF0001: Fluent theme is marked experimental in .NET 10. WFO0003: DPI awareness is intentionally declared in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Publishing: self-contained single-file x64 executable (no .NET install required). -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxShift.Audio\VoxShift.Audio.csproj" />
    <ProjectReference Include="..\VoxShift.Core\VoxShift.Core.csproj" />
  </ItemGroup>
</Project>
